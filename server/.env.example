# Server Configuration

# Port for backend server
PORT=3001

# Admin password for login (CHANGE THIS IN PRODUCTION)
ADMIN_PASSWORD=admin123@HY_CSUF

# JWT secret for token generation (CHANGE THIS IN PRODUCTION - use a long random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Google Sheets endpoint (optional - for form submissions)
GOOGLE_SHEETS_ENDPOINT=your-google-sheets-api-endpoint-here

# CORS origins (comma-separated for production)
# ALLOWED_ORIGINS=https://hinduyuvacusf.org,https://your-domain.com

# Email service (optional - for future)
# SENDGRID_API_KEY=your-sendgrid-key
# ADMIN_EMAIL=admin@hinduyuvacusf.com
