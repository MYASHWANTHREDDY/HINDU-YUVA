# Production Environment Variables for Backend (Railway/Render)
# ================================================
# Set these in your Railway/Render dashboard

# Server port (Railway auto-assigns PORT)
PORT=3001

# Admin password - USE A STRONG PASSWORD IN PRODUCTION!
ADMIN_PASSWORD=your-strong-admin-password-here

# JWT Secret - MUST be a long random string in production!
# Generate with: openssl rand -base64 64
JWT_SECRET=your-jwt-secret-minimum-32-characters-long-random-string

# Frontend URL for CORS (your Vercel deployment URL)
FRONTEND_URL=https://your-frontend.vercel.app
