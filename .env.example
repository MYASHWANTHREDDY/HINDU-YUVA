# Hindu YUVA Website - Environment Variables
# Copy this file to .env and fill in your values

# ================================
# Backend API Configuration
# ================================
# For development: http://localhost:3001
# For production: https://your-api-domain.com
VITE_API_URL=http://localhost:3001

# ================================
# Google Analytics Configuration
# ================================
# Get your Measurement ID from: https://analytics.google.com
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ================================
# Site Configuration
# ================================
VITE_SITE_URL=https://hinduyuvacusf.org
VITE_SITE_NAME=Hindu YUVA at CSUF
VITE_APP_VERSION=1.0.0

# ================================
# Error Tracking (Sentry)
# ================================
# Get your DSN from: https://sentry.io
VITE_SENTRY_DSN=

# ================================
# Social Media Links
# ================================
VITE_INSTAGRAM_URL=https://www.instagram.com/hinduyuva_csuf/
VITE_FACEBOOK_URL=https://facebook.com/hinduyuvacusf
VITE_WHATSAPP_NUMBER=1234567890

# ================================
# Security Notes
# ================================
# Admin authentication uses JWT tokens (server-side)
# See server/.env for ADMIN_PASSWORD and JWT_SECRET

# ================================
# Contact Information
# ================================
VITE_CONTACT_EMAIL=info@hinduyuvacusf.com
VITE_CONTACT_PHONE=(657) 278-5555

# ================================
# Meeting Information
# ================================
VITE_MEETING_LOCATION=Student Center, Room 201
VITE_MEETING_DAY=Friday
VITE_MEETING_TIME=5:00 PM - 7:00 PM
